{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Возврат билета",
  "type": "object",
  "required": ["operation_type", "operation_time", "operation_place", "ticket_number"],
  "properties": {
    "operation_type": { "const": "refund" },
    "operation_time": { "type": "string", "format": "date-time" },
    "operation_place": { "type": "string", "minLength": 1 },
    "ticket_number": { "type": "string", "pattern": "^[0-9]{13}$" }
  },
  "additionalProperties": false
}
